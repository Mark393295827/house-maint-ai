{
    "name": "house-maint-ai",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm exec -- vite",
        "dev:server": "cd server && npm run dev",
        "dev:all": "node scripts/dev-all.mjs",
        "tool:verify-apm": "npm exec -- tsx scripts/dev/verify_apm_refactor.ts",
        "tool:debug": "npm exec -- tsx scripts/dev/debug_setup.ts",
        "tool:screenshots": "scripts/dev/copy_screenshots.bat",
        "tool:commit": "scripts/dev/commit.cmd",
        "tool:verify-blackboard": "npm exec -- tsx scripts/dev/verify_blackboard.ts",
        "tool:fetch-ecc-configs": "node scripts/dev/fetch-ecc-configs.js",
        "tool:fetch-ecc-skills": "node scripts/dev/fetch-ecc-skills.js",
        "build": "npm exec -- tsc -b && npm exec -- vite build",
        "lint": "npm exec -- eslint .",
        "preview": "npm exec -- vite preview",
        "typecheck": "npm exec -- tsc --noEmit -p tsconfig.json && npm --prefix server exec -- tsc --noEmit -p tsconfig.json",
        "test:ai": "npm exec -- tsx tests/ai-regression/runner.ts",
        "test": "npm run test:frontend && npm run test:backend",
        "test:frontend": "npm exec -- vitest run --config vite.config.ts",
        "test:frontend:watch": "npm exec -- vitest --config vite.config.ts",
        "test:backend": "npm exec -- vitest run --config vitest.config.ts",
        "test:backend:watch": "npm exec -- vitest --config vitest.config.ts",
        "test:watch": "npm run test:frontend:watch",
        "test:ui": "npm exec -- vitest --config vite.config.ts --ui",
        "test:coverage": "npm run test:coverage:frontend && npm run test:coverage:backend",
        "test:coverage:frontend": "npm exec -- vitest run --config vite.config.ts --coverage",
        "test:coverage:backend": "npm exec -- vitest run --config vitest.config.ts --coverage",
        "test:e2e": "npm exec -- playwright test"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.975.0",
        "@sentry/react": "^10.36.0",
        "@tanstack/react-query": "^5.90.21",
        "@tanstack/react-virtual": "^3.11.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer-s3": "^3.0.3",
        "@types/supertest": "^6.0.3",
        "@vis.gl/react-google-maps": "^1.7.1",
        "better-sqlite3": "^12.6.2",
        "drizzle-orm": "^0.45.1",
        "jsonwebtoken": "^9.0.3",
        "leaflet": "^1.9.4",
        "lucide-react": "^0.556.0",
        "mixpanel-browser": "^2.73.0",
        "multer-s3": "^3.0.1",
        "prop-types": "^15.8.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-leaflet": "^5.0.0",
        "react-router-dom": "^7.12.0",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "stripe": "^20.3.1",
        "supertest": "^7.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.58.0",
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/leaflet": "^1.9.21",
        "@types/prop-types": "^15.7.15",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "autoprefixer": "^10.4.22",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^0.31.9",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "jsdom": "^27.4.0",
        "k6": "^0.0.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.17",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.18.0",
        "vite": "^7.2.4",
        "vitest": "^4.0.18"
    }
}
