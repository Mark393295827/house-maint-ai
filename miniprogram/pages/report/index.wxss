.index-page {
  justify-content: center;
  align-items: center;
}

.header {
  text-align: center;
  margin-bottom: 60px;
}

.title {
  font-size: 32px;
  font-weight: 700;
  display: block;
}

.subtitle {
  font-size: 16px;
  color: #94a3b8;
  margin-top: 8px;
  display: block;
}

.auth-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #1e293b;
  padding: 30px 20px;
  border-radius: 16px;
  border: 1px solid #334155;
}

.qr-icon {
  width: 120px;
  height: 120px;
  margin-bottom: 20px;
  background: #334155;
  border-radius: 8px;
}

.welcome-text {
  font-size: 14px;
  color: #cbd5e1;
  text-align: center;
  margin-bottom: 20px;
}
