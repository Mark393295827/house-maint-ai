.diagnosis-page {
  padding-top: 40px;
}

.header {
  margin-bottom: 30px;
}

.title {
  font-size: 24px;
  font-weight: 700;
}

.card {
  background: #1e293b;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
  border-left: 4px solid transparent;
}

.badge {
  color: white;
  padding: 6px 12px;
  border-radius: 16px;
  font-size: 14px;
  font-weight: 600;
  display: inline-block;
  margin-bottom: 20px;
}

.detail-row {
  margin-bottom: 12px;
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 13px;
  color: #94a3b8;
  margin-bottom: 4px;
}

.value {
  font-size: 15px;
  color: #f8fafc;
  line-height: 1.5;
}

.hypothesis {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid #334155;
}

.card-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 16px;
  display: block;
}

.video-placeholder {
  width: 100%;
  aspect-ratio: 16/9;
  background: #0f172a;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #3b82f6;
  margin-bottom: 20px;
}

.play-icon {
  font-size: 32px;
  margin-bottom: 8px;
}
